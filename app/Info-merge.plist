<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Regular Dock app: shows in the Dock and can be brought to the front;
         a status-bar item is still installed for quick access. -->
    <key>LSUIElement</key>
    <false/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- macOS 15+ Local Network privacy: the receiver registers a Bonjour
         service and listens for senders on the LAN. -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>Tape In receives audio from phones and computers on your local network.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_raop._tcp</string>
        <string>_dacp._tcp</string>
    </array>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
</dict>
</plist>
